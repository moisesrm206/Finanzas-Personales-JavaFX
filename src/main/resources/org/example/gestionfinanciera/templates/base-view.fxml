<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.gestionfinanciera.controllers.MainController"
            stylesheets="@../styles/base.css"
            styleClass="base-view">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Button styleClass="menu-toggle" focusTraversable="false">
                <graphic>
                    <FontIcon iconLiteral="fas-bars" iconSize="16" />
                </graphic>
            </Button>
            <Label text="Gestión de Finanzas Personales" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#openProfile" styleClass="profile-icon" focusTraversable="false">
                <graphic><FontIcon iconLiteral="fas-user" iconSize="22"/></graphic>
            </Button>
        </HBox>
    </top>
    <left>
        <VBox spacing="50" styleClass="sidebar">
            <Button text="Inicio" styleClass="navigation-button"
                    focusTraversable="false" onAction="#goHome">
                <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="16"/>
                </graphic>
            </Button>
            <Button text="Presupuesto" styleClass="navigation-button"
                    focusTraversable="false" onAction="#goBudget">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-line" iconSize="16"/>
                </graphic>
            </Button>
            <Button text="Exportar" styleClass="navigation-button"
                    focusTraversable="false" onAction="#goExport">
                <graphic>
                    <FontIcon iconLiteral="fas-file-export" iconSize="16"/>
                </graphic>
            </Button>

            <Button text="Movimientos" styleClass="navigation-button"
                    focusTraversable="false" onAction="#goMovements">
                <graphic>
                    <FontIcon iconLiteral="fas-dollar-sign" iconSize="16"/>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesión" styleClass="navigation-button"
                    focusTraversable="false" onAction="#logout">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16"/></graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="content" styleClass="content"/>
    </center>
</BorderPane>