<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.gestionfinanciera.controllers.BudgetController"
           stylesheets="@styles/budget.css"
           styleClass="budget-view">

    <VBox alignment="CENTER" spacing="20.0">
        <Label text="Presupuesto" styleClass="budget-title"/>
        <Label text="Aquí puedes gestionar tu presupuesto." styleClass="budget-subtitle"/>
        <!-- Aquí puedes agregar más elementos para mostrar y gestionar el presupuesto -->
    </VBox>
    <fx:include source="templates/base-view.fxml" fx:id="content"/>

</StackPane>
